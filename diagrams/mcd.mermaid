erDiagram
    PARTICIPANT {
        numerique id
        texte email
        booleen valide
        texte numero_de_validation
        date date_validité_accès 
    }
    UTILISATEUR {
        numerique id
        texte nom
        texte mot_de_passe
        texte description
        image image
        texte linkedin
        texte telephone
    }
    ROLE {
        numerique id
        texte nom
    }
    EVENEMENT {
        numerique id
        texte titre
        texte description
        texte phrase_accroche
        date date_et_heure
        texte adresse
        texte ville
        texte salle
        image image
        date date_creation
    }
    INSCRIPTION {
        numerique id
        date date_inscription
        booleen rappel_envoye
        texte utm_source
        texte utm_medium
        texte utm_campaign
    }

    PARTICIPANT ||--o| UTILISATEUR : "avoir"
    ROLE ||--o{ UTILISATEUR : "posseder"
    UTILISATEUR ||--o{ EVENEMENT : "creer"
    PARTICIPANT ||--o{ INSCRIPTION : "effectuer"
    EVENEMENT ||--o{ INSCRIPTION : "recevoir"
